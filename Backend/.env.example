PORT=5000
# Placeholder only — never commit real credentials to this file.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<db>
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cloudforge
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# REQUIRED once a deployment is created — the pipeline builds + pushes to the
# registry and fail-fast errors if DOCKER_REGISTRY_USERNAME is missing.
# Images are tagged <DOCKER_REGISTRY_USERNAME>/<image>:<tag>.
DOCKER_REGISTRY_USERNAME=
DOCKER_REGISTRY_PASSWORD=
# Optional: set to a custom registry host (defaults to Docker Hub).
DOCKER_REGISTRY_URL=

# Optional: node IP used for the exposed URL (e.g. `minikube ip`).
NODE_IP=

# Optional: Kubernetes Service type for deployments.
#   LoadBalancer (default) — works on Minikube with `minikube tunnel` running,
#     and on k3s (ships ServiceLB/Klipper). URL = load balancer ingress IP.
#   NodePort — fallback for clusters without any LoadBalancer controller;
#     URL = http://<NODE_IP>:<nodePort>.
SERVICE_TYPE=LoadBalancer

# Optional: set to true only for local development (backend on the same
# machine as Minikube + `minikube tunnel`). Enables a pre-flight check that
# rejects deployments whose Service port is already bound on this host
# (otherwise the tunnel silently routes traffic to the wrong local process).
# Leave unset/false in the cloud (Phase 2), where the check does not apply.
LOCAL_DEV=false